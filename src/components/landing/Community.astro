---
import { siteConfig } from '../../lib/site';

const links = [
  {
    title: 'Source code',
    body: 'Read the analyzer implementation, in Rust with an npm launcher.',
    href: siteConfig.repoUrl,
    cta: 'GitHub repository',
  },
  {
    title: 'Issues',
    body: 'Reproducible bugs and focused feature requests, with issue templates.',
    href: siteConfig.issuesUrl,
    cta: 'Open an issue',
  },
  {
    title: 'Contributing',
    body: 'Development commands, corpus guidance, and pull-request expectations.',
    href: siteConfig.contributingUrl,
    cta: 'Contribution guide',
  },
  {
    title: 'Releases',
    body: 'Release archives with SHA-256 checksums, Sigstore bundles, and build provenance.',
    href: siteConfig.releasesUrl,
    cta: 'GitHub Releases',
  },
  {
    title: 'Security',
    body: 'Report vulnerabilities privately; see the supported versions.',
    href: siteConfig.securityUrl,
    cta: 'Security policy',
  },
  {
    title: 'npm package',
    body: 'The npm distribution with platform-specific native binaries.',
    href: siteConfig.npmUrl,
    cta: 'View on npm',
  },
];
---

<section id="community" class="border-t border-line bg-panel/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Community</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl">
      An independent open-source project.
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">
      CukeDedup is MIT licensed and developed in the open. Bug reports should include a minimal
      sanitized fixture with application-specific names, credentials, and source removed.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-line bg-panel p-6 transition-colors hover:border-accent/40"
        >
          <h3 class="font-semibold">{link.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{link.body}</p>
          <p class="mt-4 text-sm font-medium text-accent group-hover:underline">{link.cta} ↗</p>
        </a>
      ))}
    </div>
  </div>
</section>
