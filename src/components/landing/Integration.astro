---
import { getCurrentVersion } from '../../lib/releases';

const version = await getCurrentVersion();

const actionYaml = `permissions:
  contents: read

steps:
  - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
    with:
      fetch-depth: 0
      persist-credentials: false
  - uses: figueiredoluiz/cuke-dedup@${version}
    with:
      path: .
      threshold: 5
      reporters: terminal,json,html,sarif`;

// Minimal YAML tinting: keys in violet, values in soft white.
const escapeHtml = (text: string): string =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const yamlHtml = escapeHtml(actionYaml)
  .split('\n')
  .map((line) => {
    const tinted = line
      .replace(/^(\s*(?:- )?)([\w-]+)(:)/, '$1<span class="text-[#a78bfa]">$2</span>$3')
      .replace(/(figueiredoluiz\/cuke-dedup@[\w.]+)/, '<span class="text-[#c4b5fd]">$1</span>');
    return `<span class="block whitespace-pre">${tinted || ' '}</span>`;
  })
  .join('');

const exitCodes = [
  { code: '0', meaning: 'The configured quality gate passed.' },
  {
    code: '1',
    meaning: 'The duplication threshold, an error rule, or the new-finding allowance failed.',
  },
  {
    code: '2',
    meaning:
      'Discovery, parsing, configuration, or another operational error prevented a valid run.',
  },
];
---

<section id="integration" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Integration</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl">
      From local check to CI quality gate.
    </h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <div class="overflow-hidden rounded-xl border border-line bg-[var(--cd-terminal-bg)]">
          <div class="border-b border-[var(--cd-terminal-line)] bg-[var(--cd-terminal-panel)] px-4 py-2 font-mono text-xs text-[#7d7396]">
            .github/workflows/cuke-dedup.yml
          </div>
          <pre class="overflow-x-auto p-4 font-mono text-[12px] leading-relaxed text-[#ded8ef]"><code set:html={yamlHtml} /></pre>
        </div>
        <p class="mt-3 text-xs text-muted">
          The Action downloads a native binary and verifies its checksum and build provenance.
          Changed-file checks, baselines, report artifacts, and hardened pinning are covered in the
          docs.
        </p>
      </div>

      <div class="space-y-6">
        <div>
          <h3 class="font-semibold">Predictable exit codes</h3>
          <dl class="mt-3 space-y-3 text-sm">
            {exitCodes.map((entry) => (
              <div class="flex gap-3">
                <dt class="w-6 shrink-0 font-mono font-bold text-accent">{entry.code}</dt>
                <dd class="leading-relaxed text-muted">{entry.meaning}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-xs text-muted">Warnings alone never produce exit code 1.</p>
        </div>
        <div class="rounded-xl border border-line bg-panel p-5 text-sm leading-relaxed text-muted">
          <p class="font-semibold text-ink">Fits the workflow you already have</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-4">
            <li>
              <strong class="font-semibold text-ink">Local:</strong> run
              <code class="font-mono text-[12.5px]">cuke-dedup .</code> from any project root — zero
              configuration required.
            </li>
            <li>
              <strong class="font-semibold text-ink">Code review:</strong> HTML and JSON reports,
              suppressions with reasons, and semantic baselines keep signal high.
            </li>
            <li>
              <strong class="font-semibold text-ink">CI:</strong> the GitHub Action, changed-file
              analysis with <code class="font-mono text-[12.5px]">--changed-since</code>, and SARIF
              upload for code scanning.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
