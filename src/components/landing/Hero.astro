---
import Terminal from '../shared/Terminal.astro';
import { siteConfig } from '../../lib/site';
import { getCurrentVersion } from '../../lib/releases';

const version = await getCurrentVersion();
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
    style="background:
      radial-gradient(42rem 30rem at 18% -8%, rgb(139 92 246 / 0.14), transparent 65%),
      radial-gradient(36rem 26rem at 92% 12%, rgb(109 40 217 / 0.10), transparent 60%)"
  ></div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pb-28 lg:pt-24">
    <div>
      <a
        href="/changelog/"
        class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1 text-xs font-medium text-muted transition-colors hover:border-accent/40 hover:text-ink"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {version} — latest release
      </a>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        Find duplicate step definitions.
        <span class="text-accent">Remove ambiguity.</span>
        Keep your Cucumber suite maintainable.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        CukeDedup is a fast static analyzer for duplicate, ambiguous, reusable, and unused
        Cucumber/Gherkin step definitions. It reads your project configuration and test code — and
        never executes either one.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/docs/#quick-start"
          class="inline-flex h-11 items-center rounded-lg bg-accent px-5 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition-colors hover:bg-accent-strong dark:text-[#14101f]"
        >
          Get Started
        </a>
        <a
          href="/docs/"
          class="inline-flex h-11 items-center rounded-lg border border-line bg-panel px-5 text-sm font-semibold transition-colors hover:border-accent/40"
        >
          Documentation
        </a>
        {siteConfig.repoUrl && (
          <a
            href={siteConfig.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium text-muted transition-colors hover:text-ink"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            GitHub
          </a>
        )}
      </div>
      <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 text-sm">
        <div>
          <dt class="text-muted">Detection rules</dt>
          <dd class="mt-1 text-2xl font-bold">8</dd>
        </div>
        <div>
          <dt class="text-muted">Report formats</dt>
          <dd class="mt-1 text-2xl font-bold">5</dd>
        </div>
        <div>
          <dt class="text-muted">Frameworks</dt>
          <dd class="mt-1 text-2xl font-bold">5</dd>
        </div>
      </dl>
    </div>

    <div class="space-y-4">
      <Terminal
        title="terminal"
        command="npm install --save-dev cuke-dedup"
        lines={[{ text: 'added 1 package in 2s', tone: 'dim' }]}
        note="Node.js 20 or newer. Also installable with cargo install cuke-dedup."
      />
      <Terminal
        title="terminal — cuke-dedup ."
        command="npx cuke-dedup ."
        lines={[
          { text: `CukeDedup ${version}`, tone: 'dim' },
          { text: '' },
          { text: 'duplicate-matcher', tone: 'rule' },
          {
            text: '  [error] Two step definitions use the same effective matcher',
            tone: 'error',
          },
          { text: '    --> features/steps/login.steps.ts:7:1', tone: 'location' },
          { text: '    related: features/steps/session.steps.ts:4:1', tone: 'location' },
          {
            text: '    action: Keep one definition or make the matchers intentionally distinct',
            tone: 'out',
          },
          { text: '' },
          { text: 'parameterization-candidate', tone: 'rule' },
          {
            text: '  [warning] Handler structures differ primarily in literal values',
            tone: 'warn',
          },
          { text: '    evidence: `the cart has 5 items` ↔ `the cart has 10 items`', tone: 'out' },
          { text: '' },
          {
            text: 'Analyzed 11 definitions and 12 feature steps: 3 errors, 3 warnings',
            tone: 'ok',
          },
          { text: 'Duplication: 2 of 11 definitions (18.18%) — FAIL', tone: 'warn' },
          { text: 'Detection time: 15.5 ms', tone: 'dim' },
        ]}
        note="Real output from an analysis run over a small demo project."
      />
    </div>
  </div>
</section>
