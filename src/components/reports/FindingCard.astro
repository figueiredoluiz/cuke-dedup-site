---
import type { ReportFinding } from '../../lib/report';
import { ruleLabels } from '../../lib/report';

interface Props {
  finding: ReportFinding;
}

const { finding } = Astro.props;

const severityClass =
  finding.severity === 'error'
    ? 'border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-300'
    : 'border-amber-500/40 bg-amber-500/10 text-amber-600 dark:text-amber-300';

const formatLocation = (loc: { path: string; line: number; column: number }): string =>
  `${loc.path}:${loc.line}:${loc.column}`;

const similarities: { label: string; value: number }[] = [];
if (finding.evidence.matcherSimilarity !== null) {
  similarities.push({ label: 'Matcher similarity', value: finding.evidence.matcherSimilarity });
}
if (finding.evidence.handlerSimilarity !== null) {
  similarities.push({ label: 'Handler similarity', value: finding.evidence.handlerSimilarity });
}
---

<details class="group rounded-xl border border-line bg-panel open:border-accent/40">
  <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1.5 px-5 py-4 [&::-webkit-details-marker]:hidden">
    <span
      class={`rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${severityClass}`}
    >
      {finding.severity}
    </span>
    <span class="font-mono text-xs font-semibold text-accent">{finding.rule}</span>
    <span class="min-w-0 flex-1 text-sm leading-snug">{finding.message}</span>
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-4 w-4 shrink-0 text-muted transition-transform group-open:rotate-90"
      aria-hidden="true"
    >
      <path d="M7.5 5l5 5-5 5"></path>
    </svg>
  </summary>

  <div class="space-y-4 border-t border-line px-5 py-4 text-sm">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Locations</p>
      <p class="mt-1.5 font-mono text-xs leading-relaxed">
        <a href="#" class="text-accent hover:underline" aria-disabled="true">
          {formatLocation(finding.primary)}
        </a>
        {finding.related.map((loc) => (
          <>
            <br />
            <span class="text-muted">{formatLocation(loc)}</span>
          </>
        ))}
      </p>
    </div>

    {(finding.evidence.matcherDifference || finding.evidence.handlerEvidence) && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted">Evidence</p>
        <ul class="mt-1.5 space-y-1 text-muted">
          {finding.evidence.matcherDifference && (
            <li>
              <span class="font-mono text-xs">{finding.evidence.matcherDifference}</span>
            </li>
          )}
          {finding.evidence.handlerEvidence && <li>{finding.evidence.handlerEvidence}</li>}
        </ul>
      </div>
    )}

    {similarities.length > 0 && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted">Similarity</p>
        <div class="mt-2 space-y-2">
          {similarities.map((sim) => (
            <div class="flex items-center gap-3">
              <span class="w-32 shrink-0 text-xs text-muted">{sim.label}</span>
              <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-accent-soft">
                <div
                  class="h-full rounded-full bg-accent"
                  style={`width: ${Math.round(sim.value * 100)}%`}
                ></div>
              </div>
              <span class="w-12 text-right font-mono text-xs">{Math.round(sim.value * 100)}%</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Suggested action</p>
      <p class="mt-1.5">{finding.suggestedAction}</p>
    </div>

    <p class="border-t border-line pt-3 text-xs text-muted">
      {ruleLabels[finding.rule]} · schema v3 finding
    </p>
  </div>
</details>
