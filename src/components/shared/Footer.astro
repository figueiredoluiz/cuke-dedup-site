---
import { siteConfig } from '../../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Reports', href: '/#reports' },
      { label: 'Changelog', href: '/changelog/' },
      { label: 'Documentation', href: '/docs/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Installation', href: '/docs/#install' },
      { label: 'Quick Start', href: '/docs/#quick-start' },
      { label: 'Configuration', href: '/docs/configuration/' },
      { label: 'Rules', href: '/docs/rules/' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: siteConfig.repoUrl, external: true },
      { label: 'npm', href: siteConfig.npmUrl, external: true },
      { label: 'Issues', href: siteConfig.issuesUrl, external: true },
      { label: 'Contributing', href: siteConfig.contributingUrl, external: true },
      { label: 'Security', href: siteConfig.securityUrl, external: true },
    ],
  },
];
---

<footer class="border-t border-line bg-panel/50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="text-[15px] font-bold tracking-tight">
          Cuke<span class="text-accent">Dedup</span>
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          Static analysis for duplicate and reusable Cucumber step definitions.
        </p>
        <p class="mt-4 font-mono text-xs text-muted">{siteConfig.domain}</p>
      </div>
      {columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="text-sm font-semibold">{column.title}</p>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link && link.external ? '_blank' : undefined}
                  rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-muted transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-10 border-t border-line pt-6 text-xs leading-relaxed text-muted">
      <p>
        {siteConfig.name} is an independent open-source project, MIT licensed. It is not affiliated
        with or endorsed by the Cucumber project or its maintainers. Before version 1.0,
        configuration and machine-report schemas may change between minor releases.
      </p>
      <p class="mt-2">© {year} CukeDedup contributors.</p>
    </div>
  </div>
</footer>
